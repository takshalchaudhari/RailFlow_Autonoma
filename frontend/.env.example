# ============================================================================
# RailFlow Frontend Configuration (C:\Users\Dell\Desktop\rail\frontend\.env)
# ============================================================================
# All frontend variables are optional. Do NOT put ELEVENLABS_API_KEY here.

# Backend FastAPI URL (auto-falls back between :8010 and :8000 if unset)
VITE_API_BASE_URL=http://127.0.0.1:8010

# Optional MapLibre GL style URL / token if custom geographic vector tiles are desired.
# Leave unset to use the built-in 3D Station Digital Twin + 2D Track Schematic.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/ch-swisstopo-lbm-dark/style.json
# VITE_MAP_PUBLIC_TOKEN=your_optional_map_tile_token
