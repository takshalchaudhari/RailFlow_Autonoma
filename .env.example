# ============================================================================
# RailFlow Backend Configuration (C:\Users\Dell\Desktop\rail\.env)
# ============================================================================
# The core CP-SAT scheduler, independent validator, and deterministic NL parser
# work 100% locally without any API keys. Add the keys below to enable live
# ElevenLabs voice synthesis and/or external LLM natural-language parsing.

# 1. ElevenLabs Voice Operator (Server-Side Only — Never Exposed to Browser)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 2. Optional OpenAI-Compatible LLM for Natural-Language Disruption Parsing
#    Set RAILFLOW_LLM_PROVIDER=openai to enable; leave as "none" for offline regex parser.
RAILFLOW_LLM_PROVIDER=none
RAILFLOW_LLM_API_KEY=your_optional_api_key_here
RAILFLOW_LLM_MODEL=gpt-4o-mini
RAILFLOW_LLM_BASE_URL=https://api.openai.com/v1

# 3. Database & CORS Settings (Optional — sensible defaults are built in)
RAILFLOW_DB_PATH=railflow.db
RAILFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
